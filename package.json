{
  "name": "test-wordpress-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Tailwind build tools for the custom WordPress theme",
  "scripts": {
    "build": "tailwindcss -i ./input.css -o ./style.css --minify",
    "watch": "tailwindcss -i ./input.css -o ./style.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "tailwindcss": "3.4.17",
    "tailwindcss-animate": "1.0.7"
  }
}
